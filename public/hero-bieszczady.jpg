            <h1 id="headline"><strong>AI Anime Image Upscaler</strong></h1>
            <p class="lead mb-4">Transform your anime art, manga panels, and illustrations into stunning high-resolution masterpieces</p>

            <div id="settings" style="display:none;">

                <div class="mb-4">
                    <label class="form-label">Select Best Model for Anime:</label>
                    <select id="modelSelect" class="form-select custom-select" onchange="onModelChanged()">
                        <option value="plus" selected>Plus (Recommended for Anime)</option>
                        <option value="general">General (Best for Large Anime Art)</option>
                    </select>
                    <small class="text-muted">Plus and General models work best for anime artwork</small>
                </div>

                <div id="scaleSettings" class="mb-3">
                    <label class="form-label">Upscale Your Anime Art</label>
                    <div style="gap:3px;" class="d-flex justify-content-center flex-wrap">
                        <button type="button" class="btn btn-outline-primary scale-btn" data-scale="1"
                                onclick="updateScale(1)">1x
                        </button>
                        <button type="button" class="btn btn-primary scale-btn" data-scale="2"
                                onclick="updateScale(2)">2x
                        </button>
                        <button type="button" class="btn btn-outline-primary scale-btn" data-scale="3"
                                onclick="updateScale(3)">3x
                        </button>
                        <button type="button" class="btn btn-outline-primary scale-btn" data-scale="4"
                                onclick="updateScale(4)">4x
                        </button>
                        <button type="button" class="btn btn-outline-primary scale-btn" data-scale="-1"
                                onclick="updateScale(-1)">4MP
                        </button>
                        <button type="button" class="btn btn-outline-primary scale-btn" data-scale="-2"
                                onclick="updateScale(-2)">8MP
                        </button>
                        <button type="button" class="btn btn-outline-primary scale-btn" data-scale="-3"
                                onclick="updateScale(-3)">16MP
                        </button>
                    </div>
                </div>

                <div id="usefxsettings" class="mb-3" style="display: none;">
                    <div class="form-check form-switch d-flex justify-content-center checkbox-wrapper">
                        <input id="fx_ui" type="checkbox" class="switch" onchange="syncfx();">
                        <label class="form-check-label" for="fx_ui">use Face Restoration</label>
                    </div>
                    <p class="text-center text-muted"><small>(Not recommended for anime - designed for human faces only)</small></p>
                </div>

                <div id="diffusersettings" class="mb-3">
                    <textarea onchange="syncprompt();" class="form-control" placeholder="Recommended: Describe your anime image (e.g., 'anime girl with blue hair', 'manga panel')" id="prompt_ui" name="prompt" maxlength="600"></textarea>

                    <label class="mb-0" for="creativity_ui">Creative enhancement for anime details</label><br>
                    <input type="range" onchange="synccreativity();" id="creativity_ui" name="creativity" min="0" max="1" step="0.01" value="0" style="width: 200px;">
                </div>
            </div>

            <div class="d-flex justify-content-center flex-wrap">
                <a id="fileA" class="btn btn-custom btn-primary" onclick="selectfiles();">Select Anime Images</a>
